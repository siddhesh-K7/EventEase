@page "/about"

<PageTitle>About - EventEase</PageTitle>

<div class="container mt-5 text-center">
    <h1 class="text-primary mb-4">About EventEase</h1>
    <p class="lead w-75 mx-auto">
        EventEase is a modern, responsive Blazor WebAssembly application built for seamless event management. 
        It allows users to discover, register for, and track upcoming tech events.
    </p>
    
    <div class="row mt-5 justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-sm">
                <div class="card-body text-start">
                    <h4>Features</h4>
                    <ul>
                        <li>Component-based architecture</li>
                        <li>Robust form validation</li>
                        <li>User session management</li>
                        <li>Real-time attendance tracking</li>
                        <li>Responsive Bootstrap UI</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>
