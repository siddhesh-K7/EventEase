@page "/event/{id:int}"
@inject EventService EventService

<PageTitle>Event Details - EventEase</PageTitle>

<div class="container">
    @if (Event == null)
    {
        <div class="alert alert-warning">Event not found.</div>
        <a href="events" class="btn btn-secondary">Back to Events</a>
    }
    else
    {
        <div class="card shadow">
            <div class="card-header bg-primary text-white">
                <h2>@Event.Name</h2>
            </div>
            <div class="card-body">
                <p class="lead">@Event.Description</p>
                <hr />
                <div class="row">
                    <div class="col-md-6">
                        <h4>Details</h4>
                        <ul>
                            <li><strong>Category:</strong> @Event.Category</li>
                            <li><strong>Date:</strong> @Event.Date.ToString("D")</li>
                            <li><strong>Time:</strong> @Event.Time</li>
                            <li><strong>Location:</strong> @Event.Location</li>
                        </ul>
                    </div>
                    <div class="col-md-6">
                        <h4>Availability</h4>
                        <p><strong>Total Capacity:</strong> @Event.MaximumCapacity</p>
                        <p><strong>Available Seats:</strong> <span class="badge @(Event.AvailableSeats > 0 ? "bg-success" : "bg-danger")">@Event.AvailableSeats</span></p>
                    </div>
                </div>
                <div class="mt-4">
                    @if (Event.IsRegistrationOpen)
                    {
                        <a href="register/@Event.Id" class="btn btn-success btn-lg">Register Now</a>
                    }
                    else
                    {
                        <button class="btn btn-secondary btn-lg" disabled>Sold Out</button>
                    }
                    <a href="events" class="btn btn-outline-secondary btn-lg ms-2">Back to Events</a>
                </div>
            </div>
        </div>
    }
</div>

@code {
    [Parameter]
    public int Id { get; set; }

    public Event? Event { get; set; }

    protected override void OnInitialized()
    {
        Event = EventService.GetEventById(Id);
    }
}
