@using EventEase.Models

<div class="card event-card h-100 shadow-sm">
    <div class="card-body d-flex flex-column">
        <h5 class="card-title text-primary">@Event.Name</h5>
        <h6 class="card-subtitle mb-2 text-muted">@Event.Category</h6>
        <p class="card-text">@Event.Description</p>
        
        <ul class="list-unstyled mt-auto">
            <li><strong>Date:</strong> @Event.Date.ToString("MMM dd, yyyy") at @Event.Time</li>
            <li><strong>Location:</strong> @Event.Location</li>
            <li><strong>Capacity:</strong> @Event.AvailableSeats / @Event.MaximumCapacity available</li>
        </ul>
        
        <div class="mt-3">
            @if (Event.IsRegistrationOpen)
            {
                <span class="badge bg-success mb-2">Registration Open</span>
                @if(ShowRegisterButton)
                {
                    <a href="register/@Event.Id" class="btn btn-primary w-100">Register Now</a>
                }
            }
            else
            {
                <span class="badge bg-danger mb-2">Sold Out</span>
                @if(ShowRegisterButton)
                {
                    <button class="btn btn-secondary w-100" disabled>Fully Booked</button>
                }
            }
        </div>
        @if(ShowDetailsButton)
        {
            <div class="mt-2">
                <a href="event/@Event.Id" class="btn btn-outline-info w-100">View Details</a>
            </div>
        }
    </div>
</div>

@code {
    [Parameter]
    public Event Event { get; set; } = default!;

    [Parameter]
    public bool ShowRegisterButton { get; set; } = true;

    [Parameter]
    public bool ShowDetailsButton { get; set; } = true;
}
